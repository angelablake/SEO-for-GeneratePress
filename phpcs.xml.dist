<?xml version="1.0"?>
<ruleset name="SEO for GeneratePress">
	<description>WordPress coding standards for SEO for GeneratePress.</description>
	<file>seo-for-generatepress.php</file>
	<file>includes</file>
	<file>uninstall.php</file>
	<exclude-pattern>tests/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP">
		<properties>
			<property name="testVersion" value="7.4-"/>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="seo-for-generatepress"/>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="seogp,SEOGP,AngelaBlake"/>
		</properties>
	</rule>
</ruleset>
